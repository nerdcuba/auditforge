# AuditForge worker — configúralo en Coolify, en el recurso worker. NUNCA commitees valores.

# Conexión Postgres con el rol auditforge_worker. No uses la service role aquí.
WORKER_DATABASE_URL=
# Clave pública Ed25519 (SPKI PEM) que verifica los scope_token.
SCOPE_TOKEN_PUBLIC_KEY=
ANTHROPIC_API_KEY=
WORKER_ID=worker-1
