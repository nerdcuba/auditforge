# AuditForge — deployment variables. You normally do NOT edit this by hand:
# `./scripts/install.sh` generates deploy/.env with all secrets. This file is a REFERENCE.
# NEVER commit deploy/.env (it's in .gitignore).

# Public host (where it's accessed from). On your PC, the machine's IP; on a VPS, your domain.
PUBLIC_HOST=192.168.1.50
PUBLIC_SCHEME=http
GATEWAY_PORT=8000
WEB_PORT=3000
MAIL_UI_PORT=8025
SUPABASE_PUBLIC_URL=http://192.168.1.50:8000
SITE_URL=http://192.168.1.50:3000

# Database and Supabase (generated).
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
DISABLE_SIGNUP=true
MAILER_AUTOCONFIRM=false

# AuditForge (generated).
SETTINGS_ENCRYPTION_KEY=
SCOPE_TOKEN_PRIVATE_KEY=
SCOPE_TOKEN_PUBLIC_KEY=
WORKER_DB_PASSWORD=
AUDITFORGE_SCAN_DISPATCH=queue

# Optional Claude-BugHunter integration (pin a REVIEWED commit to install cbh).
PACK_COMMIT=
ENGAGEMENT_CMD=
