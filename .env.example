# AuditForge web — copy to .env.local in development, or set it in Coolify. NEVER commit values.

# Public. In Coolify, also mark these as build variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the panel, no trailing slash. e.g. https://audit.yourdomain.com
SITE_URL=

# Web server only.
SUPABASE_SERVICE_ROLE_KEY=
# Ed25519 private key (PKCS8 PEM) that signs the scope_token.
SCOPE_TOKEN_PRIVATE_KEY=
# Encrypts each user's Claude key. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not change it once in use, or stored keys can't be decrypted.
SETTINGS_ENCRYPTION_KEY=

# The Claude (Anthropic) key does NOT go here: each user sets it inside the app, in Settings.

# Optional. Route the AI orchestrator through your own gateway/proxy compatible with the
# Anthropic API (e.g. LiteLLM). Leave empty to use the official API.
ANTHROPIC_BASE_URL=

# How recon/passive scans run: "inline" (default, in the web itself) or "queue" (enqueued and
# picked up by the isolated worker). Set "queue" ONLY with the worker deployed.
AUDITFORGE_SCAN_DISPATCH=inline
