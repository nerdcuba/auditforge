# AuditForge worker — set this in the worker resource in Coolify. NEVER commit values.

# Postgres with the auditforge_worker role (login+password created in the Supabase SQL editor).
# Do NOT use the service role here. Format: postgres://auditforge_worker:PASS@HOST:5432/postgres
WORKER_DATABASE_URL=

# Ed25519 public key (SPKI PEM) that verifies the scope_token. Public key only: the worker must
# never hold the private one. You can paste the PEM with escaped \n on a single line.
SCOPE_TOKEN_PUBLIC_KEY=

# This worker's id and poll interval (ms).
WORKER_ID=worker-1
WORKER_POLL_MS=3000

# Optional Claude-BugHunter integration. Leave empty to use the internal passive recon.
# Set it to /app/scripts/engagement.sh ONLY if you built the image with PACK_COMMIT (pack installed).
# The command runs in an isolated directory and writes the contract findings file.
ENGAGEMENT_CMD=
ENGAGEMENT_TIMEOUT_MS=600000

# The pack's Claude key (when Claude Code with the skills is used, in the active phase).
ANTHROPIC_API_KEY=
